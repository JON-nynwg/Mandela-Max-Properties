rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /listings/{id} {
      allow read: if true;
      // Only the owner's login can add, change or delete listings. Replace the email below.
      allow write: if request.auth != null && request.auth.token.email in ['REPLACE_WITH_YOUR_ADMIN_EMAIL'];
    }
  }
}
