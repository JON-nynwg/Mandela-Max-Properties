rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /listings/{file} {
      allow read: if true;
      // Only the owner's login can upload photos (images under 8 MB). Replace the email below.
      allow write: if request.auth != null
        && request.auth.token.email in ['REPLACE_WITH_YOUR_ADMIN_EMAIL']
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.token.email in ['REPLACE_WITH_YOUR_ADMIN_EMAIL'];
    }
  }
}
